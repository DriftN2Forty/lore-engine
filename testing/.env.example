# Server-only; no NEXT_PUBLIC variables. Windows node is simplest for Windows llama.cpp.
RVN_BASE_URL=http://127.0.0.1:8080
RVN_MODEL=rvn-iq2m-base
RVN_CONTEXT_CAP=8192
RVN_OUTPUT_TOKENS=600
RVN_TIMEOUT_MS=180000
# Optional expected SHA-256 of /props chat_template, after a local verification run.
RVN_TEMPLATE_SHA256=
